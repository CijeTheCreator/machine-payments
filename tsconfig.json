{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~~/*": ["./packages/nextjs/*"],
      "@/*": ["./packages/nextjs/*"]
    }
  },
  "include": ["scripts/**/*", "test/**/*"]
}
